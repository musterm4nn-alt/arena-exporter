{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arena-exporter.local/schemas/export-2.1.schema.json",
  "title": "Arena Exporter export schema 2.1",
  "description": "Compatibility schema for Arena Exporter JSON exports. Consumers should ignore unknown additive fields.",
  "type": "object",
  "required": ["schema_version", "export", "session", "messages", "battles", "attribution_samples", "summary", "meta"],
  "properties": {
    "schema_version": { "const": "2.1" },
    "export": {
      "type": "object",
      "required": ["mode", "exported_at", "extension_version", "source"],
      "properties": {
        "mode": { "type": "string" },
        "exported_at": { "type": "string", "format": "date-time" },
        "extension_version": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["site", "mode"],
          "properties": {
            "site": { "type": "string" },
            "mode": { "type": "string" },
            "url": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "session": {
      "type": "object",
      "required": ["session_id", "conversation_key"],
      "properties": {
        "session_id": { "type": ["string", "null"] },
        "conversation_key": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "orchestrator_model": { "type": ["string", "null"] },
        "orchestrator_model_source": { "type": "string" },
        "turn_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "battles": { "type": "array", "items": { "$ref": "#/$defs/battle" } },
    "attribution_samples": { "type": "array", "items": { "$ref": "#/$defs/attributionSample" } },
    "summary": { "type": "object", "additionalProperties": true },
    "meta": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true,
  "$defs": {
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "text": { "type": "string" },
        "role": { "type": "string" },
        "format": { "type": "string" },
        "call_id": { "type": ["string", "null"] },
        "tool_name": { "type": "string" },
        "arguments": {},
        "output": {},
        "status": { "type": "string" },
        "artifact_type": { "type": "string" },
        "title": { "type": "string" },
        "content_or_url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "role": { "type": "string" },
        "turn_index": { "type": "integer", "minimum": 0 },
        "content": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "contestant": {
      "type": "object",
      "required": ["lane"],
      "properties": {
        "lane": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "model_source": { "type": "string" },
        "model_identity_verified": { "type": "boolean" },
        "response": { "type": "string" },
        "reasoning": { "type": ["string", "null"] },
        "files": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "tool_calls": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "battle": {
      "type": "object",
      "required": ["mode", "contestants"],
      "properties": {
        "evaluation_id": { "type": ["string", "null"] },
        "mode": { "type": "string" },
        "prompt": { "type": ["string", "null"] },
        "anonymous": { "type": "boolean" },
        "contestants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contestant" } },
        "outcome": { "type": "string" },
        "vote_choice": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "requestAttempt": {
      "type": "object",
      "required": ["request_id", "outcome"],
      "properties": {
        "request_id": { "type": "string" },
        "outcome": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "integer" },
        "retry_of": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "attributionSample": {
      "type": "object",
      "required": ["sample_id", "conversation_key", "mode", "blocks"],
      "properties": {
        "sample_id": { "type": "string" },
        "conversation_key": { "type": "string" },
        "mode": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "model_labeled": { "type": "boolean" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": true
    }
  }
}
