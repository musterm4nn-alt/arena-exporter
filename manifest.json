{
  "manifest_version": 3,
  "name": "Arena Agent Exporter",
  "version": "1.10.0",
  "key": "",
  "description": "Export arena.ai Agent Mode and Battle Mode conversations as structured, LLM-friendly JSON with reasoning, tools, artifacts, model names, and explicit A/B/both/neither battle outcomes.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads", "clipboardWrite", "nativeMessaging"],
  "host_permissions": ["https://arena.ai/*", "https://*.arena.ai/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
      "js": ["src/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
      "js": ["src/lib/schema.js", "src/lib/dom-extract.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Arena Agent Exporter"
  },
  "options_page": "src/options.html"
}

