{
  "manifest_version": 3,
  "name": "Arena Exporter",
  "version": "2.1.0",
  "key": "",
  "description": "Your Arena conversations, kept. Capture, export and archive every turn, with optional private GitHub backup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "arena-agent-exporter@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "personalCommunications",
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "downloads",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "downloads.ui"
  ],
  "optional_host_permissions": [
    "https://api.github.com/*"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "https://*.arena.ai/*",
    "https://lmarena.ai/*",
    "https://*.lmarena.ai/*",
    "https://*.r2.cloudflarestorage.com/*",
    "https://*.r2.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*",
        "https://lmarena.ai/*",
        "https://*.lmarena.ai/*"
      ],
      "js": [
        "src/lib/schema.js",
        "src/lib/privacy.js",
        "src/lib/page-data.js",
        "src/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*",
        "https://lmarena.ai/*",
        "https://*.lmarena.ai/*"
      ],
      "js": [
        "src/lib/schema.js",
        "src/lib/privacy.js",
        "src/lib/page-data.js",
        "src/lib/dom-extract.js",
        "src/history-backfill.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Arena Exporter",
    "default_icon": {
      "16": "icons/led/16-idle.png",
      "32": "icons/led/32-idle.png",
      "48": "icons/led/48-idle.png"
    }
  },
  "options_page": "src/options.html"
}
