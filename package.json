{
  "name": "arena-exporter",
  "version": "3.0.0",
  "private": true,
  "description": "Keep your Arena conversations: capture every turn, read the archive offline, and back it up privately.",
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "build": "node tools/build-release.mjs",
    "check:project": "node tools/check-project.mjs",
    "schema:check": "node tools/validate-schema.mjs",
    "lint": "node tools/lint.mjs",
    "verify": "npm test && npm run lint",
    "acceptance:preview": "node tools/acceptance.mjs",
    "release:local": "node tools/release-local.mjs",
    "preview": "node tools/preview.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
